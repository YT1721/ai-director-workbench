# Application
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
PROJECTS_ROOT=./data/projects
# Current main version: UCODE-9 + FLOW-NAV + VP-PRECISION-18 + DIRECTOR-TECH PLUS + UNIFIED-SB
SYSTEM_PROMPT_FILE=./system-prompts/剧本视觉化创作系统_V7.0_Plus_R1_当前主版本.txt
CORS_ORIGINS=http://localhost:6001,http://127.0.0.1:6001

# Frontend
# 默认留空：前端通过 6001 同源代理访问后端，避免浏览器跨端口连接失败。
VITE_API_BASE_URL=
# 正式使用保持 false；设为 true 才显示开发调试备用入口。
VITE_SHOW_DEV_TOOLS=false
# Feature flags
TEXT_PROVIDER_MODE=huimeng_chat
ENABLE_REAL_TEXT_ANALYSIS=true
AUTO_RUN_TEXT_TASKS=false
IMAGE_REAL_SUBMIT_ENABLED=false
SEEDANCE_REAL_SUBMIT_ENABLED=false
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE25_MODEL_ID=doubao-seedance-2-5-260628
# 首期必须保持 false；只运行明确标识的 Mock 任务，不产生真实费用。
SEEDANCE25_LIVE_ENABLED=false
ENABLE_JIMENG_CREDIT_ASSIST=true
ENABLE_UCODE_9=true
ENABLE_STORYBOARD_STYLE_LOCK=true
ENABLE_AXIS_CONTINUITY_LOCK=true

# JiMeng / Dreamina CLI
# 本通道不需要在 .env 写账号密码或 Token。请按官方流程在本机安装 dreamina，
# 并在终端完成 dreamina login；应用只检测 dreamina user_credit 是否可用。

# OpenAI - do not commit real keys
# 也可以在“成本与设置 → AI 服务配置中心”中写入本机 .env；页面不会回显密钥。
OPENAI_API_KEY=
OPENAI_MODEL_DIRECTOR=
OPENAI_MODEL_ROUTINE=
OPENAI_IMAGE_MODEL_PRODUCTION=
OPENAI_IMAGE_MODEL_DRAFT=
OPENAI_MAX_OUTPUT_TOKENS=12000

# Seedance 视频服务通道：默认只允许 1 个任务，真实提交必须预算确认 + 页面二次确认。
VIDEO_PROVIDER_MODE=jimeng_cli
DEFAULT_VIDEO_PROVIDER_ID=huimeng_live

# Third-party Seedance Aggregator - configure only after choosing a provider and checking its official docs
SEEDANCE_AGGREGATOR_API_KEY=
SEEDANCE_AGGREGATOR_BASE_URL=
SEEDANCE_AGGREGATOR_CREATE_TASK_PATH=
SEEDANCE_AGGREGATOR_GET_TASK_PATH_TEMPLATE=
SEEDANCE_AGGREGATOR_CANCEL_TASK_PATH_TEMPLATE=
SEEDANCE_AGGREGATOR_AUTH_TYPE=bearer
SEEDANCE_AGGREGATOR_AUTH_HEADER=Authorization
SEEDANCE_AGGREGATOR_AUTH_PREFIX=Bearer 
SEEDANCE_AGGREGATOR_MODEL_ID=

# HuiMeng / 绘梦 AI provider account - do not commit real keys
# 一个 HUIMENGI_API_KEY 可共用；文本、图像、视频模型需要分开配置。
# 也可以在“成本与设置 → AI 服务配置中心”中写入本机 .env；真实提交仍需任务页逐次确认。
HUIMENGI_API_KEY=
HUIMENGI_TEXT_BASE_URL=https://api.huimengi.com/v1
HUIMENGI_TEXT_MODEL=gpt-5.5
HUIMENGI_IMAGE_BASE_URL=https://api.huimengi.com
HUIMENGI_IMAGE_MODEL=image-2
HUIMENGI_VIDEO_BASE_URL=https://api.huimengi.com
HUIMENGI_VIDEO_MODEL=seedance-2.0-fast
# Legacy aliases kept for existing video workflow compatibility
HUIMENGI_BASE_URL=https://api.huimengi.com
HUIMENGI_MODEL_ID=seedance-2.0-fast

# Atlas Cloud disabled-state adapter - keep empty until a later live-test gate
ATLASCLOUD_API_KEY=

# Optional official Volcengine fallback - reserved for later milestones
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
VOLCENGINE_SEEDANCE_MODEL_ID=

# Cost controls
REQUIRE_VIDEO_BUDGET_CONFIRM=true
MAX_VIDEO_TASKS_PER_BATCH=100
# 已提交视频由 FastAPI 后台持续查询并在完成后保存到项目目录。
VIDEO_TASK_SUPERVISOR_ENABLED=true
VIDEO_TASK_POLL_INTERVAL_SECONDS=5
CONTENT_TASK_SUPERVISOR_ENABLED=true
CONTENT_TASK_POLL_INTERVAL_SECONDS=2
IMAGE_TASK_SUPERVISOR_ENABLED=true
IMAGE_TASK_POLL_INTERVAL_SECONDS=5
